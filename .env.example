POSTGRES_DB=erp
POSTGRES_USER=erp_app
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
POSTGRES_PORT=5432

ConnectionStrings__Erp=Host=localhost;Port=5432;Database=erp;Username=erp_app;Password=replace-with-a-long-random-local-password;Pooling=true;Maximum Pool Size=100
Jwt__Issuer=erp-api
Jwt__Audience=erp-client
Jwt__SigningKey=replace-with-a-long-random-development-key

# Flutter Docker settings
FRONTEND_DEV_PORT=8080
FRONTEND_PROD_PORT=80
FLAVOR=admin
USE_MOCK_DATA=true
