FROM ghcr.io/cirruslabs/flutter:stable

WORKDIR /app

# Pre-fetch dependencies during image build
COPY pubspec.yaml pubspec.lock ./
RUN flutter pub get

EXPOSE 8080

# Bind to 0.0.0.0 so host port forwarding works properly
CMD ["flutter", "run", "-d", "web-server", "--web-hostname=0.0.0.0", "--web-port=8080", "--target=lib/main_dev.dart", "--dart-define=FLAVOR=dev", "--dart-define=USE_MOCK_DATA=true"]